# ==============================================================================
# Watson 24/7 AI Agent Environment Configuration (.env)
# 1-Click Self-Hosting Setup Wizard (ADR-046)
# ==============================================================================

# 1. 서버 기본 설정
PORT=8000
ENV=production
DATABASE_URL=sqlite:///./app.db
TIMEZONE=Asia/Seoul

# 2. AI 엔진 설정 (Gemini API)
# Google AI Studio(https://aistudio.google.com/)에서 무료 발급 가능
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# 3. 텔레그램 봇 연동 (필수)
# @BotFather(https://t.me/BotFather)에서 봇 생성 후 획득한 HTTP API Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# @userinfobot(https://t.me/userinfobot)에서 확인한 본인의 숫자 ID (쉼표로 복수 등록 가능)
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# 4. Git 및 GTD 저장소 설정 (ADR-007)
# 독립된 개인 라이프로그/GTD Git 저장소 절대경로 (비어있으면 기본 ./lifelogs 사용)
GTD_PATH=
REPO_PATH=.
GIT_REMOTE_NAME=origin
GIT_BRANCH=main

# 5. 웹 대시보드 보안 인증 (ADR-015)
# 외부 접속 시 무단 접근 방지를 위한 HTTP Basic Auth
WEB_AUTH_ENABLED=false
WEB_AUTH_USERNAME=watson
WEB_AUTH_PASSWORD=your_secure_password_here

# 6. Cloudflare Tunnel (포트포워딩 없는 무료 자동 HTTPS 터널링)
CLOUDFLARE_TUNNEL_TOKEN=
