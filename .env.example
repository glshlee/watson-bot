# ==============================================================================
# Watson 24/7 AI Agent Environment Configuration (.env)
# ==============================================================================

# 1. 서버 기본 설정
PORT=8000
ENV=production
DATABASE_URL=sqlite:///./app.db

# 2. LLM 엔진 설정 (Gemini API)
# Google AI Studio(https://aistudio.google.com/)에서 무료 발급 가능
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# 3. Git 원격 저장소 자동화 설정
REPO_PATH=.
GIT_REMOTE_NAME=origin
GIT_BRANCH=main

# 4. 텔레그램 봇 연동 (Phase 3용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# 5. 웹 콘솔 보안 및 Cloudflare Tunnel (ADR-015)
WEB_AUTH_ENABLED=false
WEB_AUTH_USERNAME=watson
WEB_AUTH_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
