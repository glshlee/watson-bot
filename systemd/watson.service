[Unit]
Description=Watson 24/7 GitHub LifeLog AI Agent Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/workspace/watson-bot
EnvironmentFile=/home/ubuntu/workspace/watson-bot/.env
Environment="PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/workspace/watson-bot/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --timeout-keep-alive 75 --limit-concurrency 100
Restart=always
RestartSec=5s

# 표준 출력 및 에러 로깅
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
